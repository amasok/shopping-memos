# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/shopping_memos"

# NextAuth（#61 A3a で Better Auth に切り替えるまで使う。A6 で消す）
AUTH_SECRET="your-secret-here"

# Google OAuth（A6 で消す）
# Google Cloud Console で OAuth 2.0 クライアントIDを作成
# https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# Better Auth（#61）
# ローカルの開発では、空なら開発用の値になる。本番・Vercel では必須（起動時に確かめる）
# 生成例: openssl rand -base64 32（BETTER_AUTH_SECRET と OTP_EVENT_HMAC_KEY は別の値にする）
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"
# Preview のホストなど、BETTER_AUTH_URL のほかに受け付けるオリジン（カンマ区切り）
BETTER_AUTH_TRUSTED_ORIGINS=""
# otp_events のメールアドレスの HMAC の鍵
OTP_EVENT_HMAC_KEY=""

# Cloudflare Turnstile（ローカルの開発で空なら、常に成功するテスト用のキーになる。本番ではテスト用のキーを拒否する）
TURNSTILE_SECRET_KEY=""
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
# 狙われたアドレス用の対話型のウィジェット（A3b）。空ならテスト用のキー
TURNSTILE_CHALLENGE_SECRET_KEY=""
NEXT_PUBLIC_TURNSTILE_CHALLENGE_SITE_KEY=""

# メール（Resend）。ローカルの開発で空なら、コードをサーバーのログに出す
RESEND_API_KEY=""
EMAIL_FROM="買い物メモ <noreply@mail.counoco.net>"
# Preview だけ: このアドレスにしか送らない（カンマ区切り）
EMAIL_RECIPIENT_ALLOWLIST=""
# 送信数のアラートの宛先（本番は必須）
OTP_ALERT_EMAIL=""
