{
  "name": "shopping-memos",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.sw.json",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:sw-lifecycle": "bash scripts/e2e-sw-lifecycle.sh",
    "test:e2e:local": "bash scripts/e2e-local.sh",
    "test:db": "bash scripts/test-db.sh",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:reset": "docker exec shopping-memos-db psql -U postgres -d shopping_memos -c 'DROP SCHEMA public CASCADE; CREATE SCHEMA public;' && npm run db:push"
  },
  "dependencies": {
    "@auth/drizzle-adapter": "^1.11.3",
    "@tanstack/react-query": "^5.90.20",
    "@trpc/client": "^11.9.0",
    "@trpc/react-query": "^11.9.0",
    "@trpc/server": "^11.9.0",
    "clsx": "^2.1.1",
    "dexie": "^4.4.7",
    "dexie-react-hooks": "^4.2.0",
    "drizzle-orm": "^0.45.4",
    "lucide-react": "^0.563.0",
    "next": "16.4.6",
    "next-auth": "5.0.0-beta.32",
    "postgres": "^4.1.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "superjson": "^2.2.6",
    "tailwind-merge": "^3.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.0",
    "@serwist/turbopack": "^9.5.14",
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^5.2.0",
    "@vitest/coverage-v8": "^4.1.12",
    "drizzle-kit": "^0.31.8",
    "esbuild": "^0.28.2",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "fake-indexeddb": "^6.2.8",
    "jsdom": "^27.4.0",
    "serwist": "^9.5.14",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vite": "^8.3.8",
    "vitest": "^4.1.12",
    "yaml": "^2.9.1"
  },
  "overrides": {
    "mysql2": "^3.24.6",
    "valibot": "^1.5.0",
    "hono": "^4.13.19",
    "lodash": "^4.18.1",
    "deepmerge-ts": "^8.0.2",
    "effect": "^3.20.0",
    "@hono/node-server": "^2.1.8"
  }
}
