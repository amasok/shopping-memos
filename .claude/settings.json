{
  "language": "japanese",
  "permissions": {
    "allow": [
      "Bash(npm run:*)",
      "Bash(npm install:*)",
      "Bash(npx drizzle-kit:*)",
      "Bash(DATABASE_URL=* npm run db:*)",
      "Bash(DATABASE_URL=* npx drizzle-kit:*)",
      "Bash(npx playwright:*)",
      "Bash(docker compose:*)",
      "Bash(gh issue:*)",
      "Bash(gh pr:*)",
      "Bash(gh label:*)",
      "Bash(gh repo:*)",
      "Bash(gh api:*)",
      "Bash(mkdir *)"
    ],
    "deny": [
      "Read(./.env)"
    ]
  },
  "attribution": {
    "commit": "Co-Authored-By: Claude Opus 4.5 <noreply@anthropic.com>"
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write",
        "hooks": [
          {
            "type": "command",
            "command": "npm run lint --fix"
          }
        ]
      }
    ]
  }
}