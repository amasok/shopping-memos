# Terraform state files
*.tfstate
*.tfstate.*

# Crash log files
crash.log
crash.*.log

# Exclude all .tfvars files, which may contain sensitive data
*.tfvars
!*.tfvars.example

# Override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Terraform directory
.terraform/

# Lock file - SHOULD be committed for reproducibility
# See: https://developer.hashicorp.com/terraform/language/files/dependency-lock
# Do NOT ignore .terraform.lock.hcl

# Terraform plan output
*.tfplan

# CLI configuration file
.terraformrc
terraform.rc
