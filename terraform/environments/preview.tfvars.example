# =============================================================================
# Preview Environment Variables
# =============================================================================
#
# プレビュー環境用の変数ファイル (develop ブランチ)
#
# 使用方法:
#   cp preview.tfvars.example preview.tfvars
#   terraform plan -var-file=environments/preview.tfvars
#
# preview.tfvars は .gitignore に含まれています
# =============================================================================

# -----------------------------------------------------------------------------
# Project Settings
# -----------------------------------------------------------------------------
# Note: 現在の構成では production と同じプロジェクトを使用
#       環境別に分離する場合は project_name を変更

project_name = "shopping-memos"
github_repo  = "amasok/shopping-memos"

# -----------------------------------------------------------------------------
# NextAuth.js
# -----------------------------------------------------------------------------

# プレビュー環境用のシークレット (本番とは別の値を推奨)
# 生成コマンド: openssl rand -base64 32
nextauth_secret = "your-preview-nextauth-secret-here"

# -----------------------------------------------------------------------------
# Google OAuth
# -----------------------------------------------------------------------------

# 本番環境と同じ認証情報を使用可能
# (リダイレクトURIにプレビューURLを追加する必要あり)
google_client_id     = "your-google-client-id.apps.googleusercontent.com"
google_client_secret = "your-google-client-secret"
