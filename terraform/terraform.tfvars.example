# =============================================================================
# Terraform Variables Example
# =============================================================================
#
# このファイルをコピーして terraform.tfvars を作成してください:
#   cp terraform.tfvars.example terraform.tfvars
#
# terraform.tfvars は .gitignore に含まれているため、
# 機密情報をコミットすることはありません。
# =============================================================================

# -----------------------------------------------------------------------------
# Project Settings
# -----------------------------------------------------------------------------

project_name = "shopping-memos"
github_repo  = "amasok/shopping-memos"

# -----------------------------------------------------------------------------
# シークレット - Vercel ダッシュボードで設定
# -----------------------------------------------------------------------------
#
# 以下の環境変数は Terraform ではなく Vercel ダッシュボードで設定してください:
#
#   NEXTAUTH_SECRET       : openssl rand -base64 32 で生成
#   GOOGLE_CLIENT_ID      : Google Cloud Console で取得
#   GOOGLE_CLIENT_SECRET  : Google Cloud Console で取得
#
# 設定場所: Vercel Dashboard > Project > Settings > Environment Variables
# Target: Production, Preview の両方に設定
#
# 理由: Terraform の tfstate ファイルに平文で保存されるリスクを回避
# -----------------------------------------------------------------------------

# -----------------------------------------------------------------------------
# Optional: Custom Domain (将来実装予定)
# -----------------------------------------------------------------------------

# カスタムドメインを使用する場合は設定
# custom_domain = "shopping.example.com"
